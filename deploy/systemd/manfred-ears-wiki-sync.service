[Unit]
Description=Mirror validated Manfred Ears Wiki exports from 7090
Documentation=file://@MANFRED_RUNTIME_ROOT@/docs/ears.md
After=network-online.target
Wants=network-online.target

[Service]
Environment=MANFRED_EXPORT_SOURCE=@MANFRED_EXPORT_SOURCE@
Environment=MANFRED_BRAIN_INBOX_DIR=@MANFRED_BRAIN_INBOX_DIR@
Environment=MANFRED_EXPORT_SSH_KEY=@MANFRED_EXPORT_SSH_KEY@
Type=oneshot
ExecStart=/usr/bin/python3 @MANFRED_RUNTIME_ROOT@/deploy/manfred_wiki_sync.py
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MANFRED_BRAIN_INBOX_PARENT@
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
