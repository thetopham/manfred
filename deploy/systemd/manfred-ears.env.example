# Copy to ~/.config/manfred-ears/manfred-ears.env (mode 0600).
PYTHONPATH=@MANFRED_RUNTIME_ROOT@
MANFRED_STATE_DIR=@MANFRED_STATE_DIR@
HF_HOME=@MANFRED_STATE_DIR@/models/huggingface
# Canonical receiver placement: 7090's Tailscale address.
MANFRED_RECEIVER_HOST=100.112.32.64
MANFRED_VISION_HOST=100.112.32.64
MANFRED_AUTH_TOKEN=replace-with-existing-companion-token
MANFRED_OPERATOR_TOKEN=replace-with-a-separate-high-entropy-token
MANFRED_VISION_TOKEN=replace-with-a-third-high-entropy-ingest-only-token
MANFRED_MAX_VISION_REQUEST_BYTES=8388608
MANFRED_MAX_VISION_IMAGE_BYTES=2097152
# Each visual anchor initially references 15 seconds of evidence before and after capture.
MANFRED_EPISODE_CONTEXT_SECONDS=15
MANFRED_EPISODE_FINALIZE_GRACE_SECONDS=2
MANFRED_ASR_BACKEND=faster-whisper
MANFRED_ASR_MODEL=large-v3-turbo
MANFRED_ASR_DEVICE=cpu
MANFRED_ASR_COMPUTE_TYPE=int8
# Canonical text uses one full-session faster-whisper/Silero pass after idle.
MANFRED_ROLLING_TRANSCRIPTION_ENABLED=false
MANFRED_SILERO_VAD_THRESHOLD=0.10
MANFRED_SILERO_VAD_NEG_THRESHOLD=0.05
MANFRED_SILERO_VAD_ROLLING_THRESHOLD=0.50
MANFRED_SILERO_VAD_ROLLING_NEG_THRESHOLD=0.35
MANFRED_SILERO_VAD_MIN_SPEECH_DURATION_MS=50
MANFRED_SILERO_VAD_MIN_SILENCE_DURATION_MS=300
MANFRED_SILERO_VAD_SPEECH_PAD_MS=300
MANFRED_WORKER_POLL_SECONDS=5
MANFRED_IDLE_FLUSH_SECONDS=20
