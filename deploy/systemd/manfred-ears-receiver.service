[Unit]
Description=Manfred Ears tailnet audio receiver and transcription worker
Documentation=file://@MANFRED_RUNTIME_ROOT@/docs/ears.md
StartLimitIntervalSec=0

[Service]
Type=simple
Environment=MANFRED_RECEIVER_HOST=@MANFRED_RECEIVER_HOST@
EnvironmentFile=@MANFRED_ENV_FILE@
WorkingDirectory=@MANFRED_RUNTIME_ROOT@
ExecStart=/usr/bin/env PYTHONPATH=@MANFRED_RUNTIME_ROOT@ @MANFRED_RUNTIME_ROOT@/.venv/bin/python -m manfred_ears serve --host ${MANFRED_RECEIVER_HOST} --port 8787 --log-level info
Restart=always
RestartSec=5
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=@MANFRED_STATE_DIR@
LockPersonality=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TasksMax=128

[Install]
WantedBy=default.target
